{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "engineering-knowledge-gardener-api",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "APP_MODE": "demo",
    "GARDEN_STALE_AFTER_DAYS": "90",
    "GARDEN_REQUIRED_METADATA_KEYS": "[\"status\",\"tags\"]",
    "GARDEN_OBSOLETE_TERMS": "[{\"term\":\"Node.js 24\",\"replacement\":\"the currently supported runtime\"}]",
    "DEMO_RETENTION_DAYS": "7",
  },
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knowledge-gardener-demo",
      "database_id": "e12a9a48-d11b-4a5e-bf4e-6c147f51930c",
      "migrations_dir": "migrations",
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true,
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "env": {
    "live": {
      "name": "engineering-knowledge-gardener-api-live",
      "vars": {
        "APP_MODE": "live",
        "GARDEN_STALE_AFTER_DAYS": "180",
        "GARDEN_REQUIRED_METADATA_KEYS": "[]",
        "GARDEN_OBSOLETE_TERMS": "[]",
        "DEMO_RETENTION_DAYS": "7",
      },
      "triggers": {
        "crons": [],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "knowledge-gardener-live",
          "database_id": "e1a72ff1-f9a7-4aba-b704-da8df024de0c",
          "migrations_dir": "migrations",
        },
      ],
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "vectorize": [
        {
          "binding": "KNOWLEDGE_INDEX",
          "index_name": "engineering-knowledge-gardener-live",
          "remote": true,
        },
      ],
      "ratelimits": [
        {
          "name": "CHAT_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
      "workflows": [
        {
          "name": "engineering-knowledge-gardener-sync-live",
          "binding": "KNOWLEDGE_SYNC",
          "class_name": "KnowledgeSyncWorkflow",
        },
      ],
    },
  },
}
