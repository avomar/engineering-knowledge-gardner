{
  "name": "@knowledge-gardener/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:local:live": "wrangler d1 migrations apply DB --local --env live",
    "dev": "wrangler dev --port 8787",
    "dev:live": "wrangler dev --env live --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@knowledge-gardener/domain": "workspace:*",
    "@knowledge-gardener/fixtures": "workspace:*",
    "@knowledge-gardener/source": "workspace:*",
    "hono": "^4.9.6",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^24.3.0",
    "miniflare": "4.20260521.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.40.0"
  }
}
